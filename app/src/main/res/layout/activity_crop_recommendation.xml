<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9F1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌾 Crop Recommendation"
            android:textColor="#245C2A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter your soil information to find suitable crops."
            android:textColor="#777777"
            android:textSize="15sp" />


        <!-- Soil Type -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Soil Type"
            android:textColor="#245C2A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSoil"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnUploadSoilReport"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="📄 Upload Soil Test Report"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtReportStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="No soil report uploaded"
            android:textColor="#777777"
            android:textSize="14sp" />


        <!-- pH -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Soil pH"
            android:textColor="#245C2A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPh"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Example: 6.5"
            android:inputType="numberDecimal"
            android:padding="12dp" />


        <!-- Nitrogen -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nitrogen (N)"
            android:textColor="#245C2A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNitrogen"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Example: 80"
            android:inputType="numberDecimal"
            android:padding="12dp" />


        <!-- Phosphorus -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Phosphorus (P)"
            android:textColor="#245C2A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPhosphorus"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Example: 40"
            android:inputType="numberDecimal"
            android:padding="12dp" />


        <!-- Potassium -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Potassium (K)"
            android:textColor="#245C2A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPotassium"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Example: 60"
            android:inputType="numberDecimal"
            android:padding="12dp" />


        <!-- Rainfall -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Rainfall (mm)"
            android:textColor="#245C2A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRainfall"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Example: 200"
            android:inputType="numberDecimal"
            android:padding="12dp" />


        <!-- Recommend -->

        <Button
            android:id="@+id/btnRecommend"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="25dp"
            android:text="🌱 Recommend Crop"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- Result -->

        <TextView
            android:id="@+id/txtRecommendation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="Your recommendation will appear here."
            android:textColor="#333333"
            android:textSize="17sp" />

    </LinearLayout>

</ScrollView>