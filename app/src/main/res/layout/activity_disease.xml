<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FFF3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgPlantPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="20dp"
            android:background="#E0E0E0"
            android:contentDescription="Selected plant photo"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🦠 Select Disease"
            android:textColor="#245C2A"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPlant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Plant: Tomato"
            android:textColor="#607060"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Choose the problem:"
            android:textColor="#245C2A"
            android:textSize="19sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioDiseases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <RadioButton
                android:id="@+id/radioHealthy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Healthy Plant"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/radioEarlyBlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Early Blight"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/radioLateBlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Late Blight"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/radioLeafMold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Leaf Mold"
                android:textSize="17sp" />

        </RadioGroup>

        <Button
            android:id="@+id/btnCheckDisease"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:text="🔍  Check Disease"
            android:textSize="17sp" />

    </LinearLayout>

</ScrollView>