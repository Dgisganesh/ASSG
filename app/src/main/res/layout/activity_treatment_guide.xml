<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FFF3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🌿 Treatment Guide"
            android:textColor="#245C2A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSelectedDisease"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Select a disease"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerDisease"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="🌱 Organic Remedies"
            android:textColor="#245C2A"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtOrganic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="Organic treatment will appear here."
            android:textColor="#444444"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="🧪 Chemical Treatment"
            android:textColor="#245C2A"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtChemical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="Chemical treatment will appear here."
            android:textColor="#444444"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="⚠️ Safety"
            android:textColor="#A06000"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSafety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFF8E1"
            android:padding="18dp"
            android:text="Always follow the product label and local agricultural guidance."
            android:textColor="#555555"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>